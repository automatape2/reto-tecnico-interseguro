# Shared HMAC secret used to sign and verify JWTs on both APIs. Must be
# identical for go-api and node-api, since go-api mints tokens that node-api
# verifies.
JWT_SECRET=change-me-to-a-long-random-string

# How long a client-facing token from POST /api/v1/auth/token stays valid.
JWT_EXPIRY_MINUTES=60

# Pre-shared key clients must send as X-API-Key to obtain a JWT from go-api.
# Stands in for a real identity provider, which is out of scope here.
GO_API_PRESHARED_KEY=change-me-preshared-key

# Host ports published by docker-compose.
GO_API_PORT=8080
NODE_API_PORT=4000
FRONTEND_PORT=8081

# How long go-api waits for node-api before giving up on a stats request.
NODE_API_TIMEOUT_MS=5000

# CORS origins go-api accepts. "*" is fine for local development; restrict
# this in a real deployment.
CORS_ALLOWED_ORIGINS=*
